{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/ascii/anjou_bust.txt",
        "padding": {
            "top": 0,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "title",
            "format": "{#38;2;249;228;122} {user-name}{#} {#90}at{#} {#38;2;180;200;220}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "{#38;2;249;228;122}╭─  system{#}"
        },
        {
            "type": "os",
            "key": "│  os     ",
            "keyColor": "38;2;249;228;122"
        },
        {
            "type": "kernel",
            "key": "│  kernel ",
            "keyColor": "38;2;249;228;122"
        },
        {
            "type": "uptime",
            "key": "│  uptime ",
            "keyColor": "38;2;249;228;122"
        },
        {
            "type": "packages",
            "key": "│  pkgs   ",
            "keyColor": "38;2;249;228;122"
        },
        {
            "type": "custom",
            "format": "{#38;2;250;123;21}├─ 󰍹 desktop{#}"
        },
        {
            "type": "wm",
            "key": "│  wm     ",
            "keyColor": "38;2;250;123;21"
        },
        {
            "type": "shell",
            "key": "│  shell  ",
            "format": "{pretty-name}",
            "keyColor": "38;2;250;123;21"
        },
        {
            "type": "terminal",
            "key": "│  term   ",
            "keyColor": "38;2;250;123;21"
        },
        {
            "type": "custom",
            "format": "{#38;2;224;159;187}╰─ 󰍛 hardware{#}"
        },
        {
            "type": "cpu",
            "key": "   cpu    ",
            "keyColor": "38;2;224;159;187"
        },
        {
            "type": "gpu",
            "key": "   gpu    ",
            "keyColor": "38;2;224;159;187"
        },
        {
            "type": "memory",
            "key": "   memory ",
            "keyColor": "38;2;224;159;187"
        },
        {
            "type": "disk",
            "key": "   disk   ",
            "folders": "/",
            "keyColor": "38;2;224;159;187"
        },
        {
            "type": "battery",
            "key": "   power  ",
            "keyColor": "38;2;224;159;187"
        },
        {
            "type": "break"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
