{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/home/huzbi/Documents/FastFetch-config/ascii/anjou_bust.txt",
        "padding": {
            "top": 0,
            "right": 3
        }
    },
    "display": {
        "separator": " ─ ",
        "color": {
            "keys": "cyan",
            "title": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "white",
                "host": "yellow"
            }
        },
        {
            "type": "custom",
            "format": "────────────────────────────────────────"
        },
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "shell",
            "key": "Shell",
            "format": "{pretty-name}"
        },
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "swap",
            "key": "Swap"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "Power"
        },
        {
            "type": "break"
        },
        {
            "type": "colors",
            "symbol": "square"
        }
    ]
}
